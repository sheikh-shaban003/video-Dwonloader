# Copy this file to .env and add your server-side OpenAI API key.
# Never paste this key into js/config.js or any frontend code.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_RESPONSES_MODEL=gpt-6-astra
# Set this only when your frontend lives on a different origin from the backend.
# Example: ALLOWED_ORIGIN=https://your-site.netlify.app
ALLOWED_ORIGIN=
